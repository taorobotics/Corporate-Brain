# Copy this file to config/deepseek.env and fill in the key locally.
# This file is intentionally safe to commit; never commit the filled copy.

BRAIN_DSH_ENABLED=1
BRAIN_DSH_HOME=.cache/dsh-runtime
DEEPSEEK_API_KEY=
DEEPSEEK_SYNC_MODELS=1
DEEPSEEK_CHAT_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
